<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Repo Phase 2 (Receiver Foundation): a LanDrop network service that is
         discoverable over mDNS/DNS-SD, accepts TCP connections, and performs
         TLS 1.3. INTERNET is required for local-network sockets; mDNS browsing
         is multicast and stays within the local network. No other permission
         is granted (protocol §39 MVP does not include authentication). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LanDrop">
        <activity
            android:name=".platform.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
