  "integration": {
    "note": "Desktop <-> Android integration scenarios (Phase 08). The artifact contents are UTF-8 strings whose total byte length equals the sum of transfer.chunk_sizes; the harness recomputes SHA-256 over the received bytes and never trusts the fixture digest. transfer_id has no wire carrier (protocol spec §17-§19) and the binary plane has no framing markers, so the harness assigns both peers the same transfer id (offline-mirror convention) exactly as delivery-flow.test.ts does.",
    "scenarios": [
      {
        "name": "full_lifecycle_success",
        "description": "discover -> connect -> TLS -> session -> request -> ACCEPT -> binary transfer -> SHA-256 verification -> install handoff -> COMPLETED on both peers",
        "decision": "ACCEPT",
        "artifact": {"contents": ["LanDrop", "-", "phase-08"], "chunk_sizes": [7, 1, 8]},
        "declared_sha256": "c55f71ee76b6c6dbc51849d51bdc41002e27f9d38405fbaa669ab9f14605e133",
        "expectation": {"sender_final_state": "COMPLETED", "receiver_final_state": "COMPLETED", "installer_invoked": true}
      },
      {
        "name": "integrity_mismatch_on_wire",
        "description": "a corrupted artifact byte on the wire makes the Receiver's computed digest differ from the declared hash -> INTEGRITY_MISMATCH, FAILED, installer never invoked",
        "decision": "ACCEPT",
        "artifact": {"contents": ["Mismatch-", "on-", "the-wire"], "chunk_sizes": [9, 3, 8]},
        "declared_sha256": "23c10cdd6761daefe46e724d25d85e921226bf9a7ab5906918d6ea603227baea",
        "tamper": {"corrupt_byte_at": 6},
        "expectation": {"sender_final_state": "FAILED", "receiver_final_state": "FAILED", "installer_invoked": false}
      },
      {
        "name": "rejected_request",
        "description": "user REJECTs the delivery request -> both peers REJECTED, no transfer, installer never invoked",
        "decision": "REJECT",
